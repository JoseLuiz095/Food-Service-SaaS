{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foodweb",
  "compatibility_date": "2026-08-27",
  "main": "worker/seo-home.js",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/robots.txt", "/sitemap.xml"]
  }
}
