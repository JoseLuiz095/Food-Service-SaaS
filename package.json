{
  "name": "foodservice-saas",
  "private": true,
  "version": "0.6.5",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "build": "npm run check:env && npm run typecheck && vite build",
    "preview": "vite preview",
    "validate": "npm run smoke && npm run test:critical && npm run test:segments && npm run test:domains && npm run test:pwa && npm run test:notifications && npm run test:security && npm run test:simple-stock && npm run test:demo-provision && npm run test:integrations && npm run test:platform && npm run test:provision && npm run build",
    "test:notifications": "node --test scripts/notification-delivery-test.mjs scripts/push-preferences-test.mjs",
    "test:integrations": "node scripts/integration-repair-db-test.mjs && node scripts/tenant-write-guards-db-test.mjs && node scripts/product-stock-db-test.mjs && node scripts/inventory-transaction-db-test.mjs",
    "test:domains": "node scripts/domain-unit-test.mjs",
    "test:pwa": "node scripts/pwa-security.mjs",
    "test:security": "node scripts/security-unit-test.mjs && node --test scripts/csv-export-test.mjs",
    "test:segments": "node scripts/segments-unit-test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "npm run build && wrangler deploy",
    "design:setup": "npx --yes impeccable@3.6.0 skills install -y --providers=codex --scope=project",
    "design:help": "node scripts/impeccable-help.mjs",
    "design:update": "npx --yes impeccable@3.6.0 skills update -y",
    "design:verify": "node scripts/verify-impeccable.mjs",
    "design:detect": "npx --yes impeccable@3.6.0 detect src/",
    "design:context": "node .agents/skills/impeccable/scripts/context.mjs --target src/App.tsx",
    "test:critical": "node scripts/critical-flow.mjs",
    "test:modules": "node scripts/test-modules.mjs",
    "qa:modules": "npm --prefix qa run test:modules",
    "check:env": "node scripts/check-env.mjs",
    "qa:setup": "npm --prefix qa install && npm --prefix qa run browser:install",
    "qa": "npm run qa:lite",
    "qa:lite": "npm --prefix qa run test:lite",
    "qa:ui": "npm --prefix qa run test:ui",
    "qa:smoke": "npm --prefix qa run test:smoke",
    "qa:e2e": "npm --prefix qa run test:e2e",
    "qa:responsive": "npm --prefix qa run test:responsive",
    "qa:visual": "npm --prefix qa run test:visual",
    "qa:authenticated": "npm --prefix qa run test:authenticated",
    "qa:a11y": "npm --prefix qa run test:a11y",
    "qa:cross-browser": "npm --prefix qa run test:cross-browser",
    "qa:update": "npm --prefix qa run update:snapshots",
    "qa:report": "npm --prefix qa run report",
    "qa:auth:admin": "npm --prefix qa run auth:admin",
    "qa:auth:master": "npm --prefix qa run auth:master",
    "qa:core": "npm --prefix qa run test:core",
    "qa:publish": "node scripts/publish-qa-release.mjs",
    "test:platform": "node scripts/segment-platform-db-test.mjs",
    "test:provision": "node --test scripts/provision-test-tenants.test.mjs",
    "test:simple-stock": "node scripts/stock-simple-mode-db-test.mjs",
    "test:demo-provision": "node --test scripts/demo-provisioning-handler-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "@types/qrcode": "^1.5.5",
    "lucide-react": "1.34.0",
    "pdfjs-dist": "6.3.289",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.151.3"
  }
}
